---
layout: base.njk
title: Home
---
<section class="hero">
  <p class="eyebrow">The team blog</p>
  <h1>{{ site.title }}</h1>
  <p class="lede">{{ site.tagline }}</p>
</section>

<section class="post-list" aria-label="Latest posts">
  {% for post in collections.posts %}
  <article class="card">
    <p class="eyebrow">
      {% for t in post.data.tags %}{% if t != "posts" %}<span class="tag">{{ t }}</span>{% endif %}{% endfor %}
    </p>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="summary">{{ post.data.summary }}</p>
    <div class="byline small">
      <span class="avatar" aria-hidden="true">{{ post.data.author | initials }}</span>
      <span><strong>{{ post.data.author }}</strong> <span class="muted">· {{ post.date | readableDate }}</span></span>
    </div>
  </article>
  {% endfor %}
</section>
